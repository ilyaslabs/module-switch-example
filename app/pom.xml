<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.example.shop</groupId>
        <artifactId>module-switch-example</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>app</artifactId>
    <name>app</name>
    <description>The Spring Boot application. Ships every module; configuration decides which ones load.</description>

    <dependencies>
        <dependency>
            <groupId>io.github.ilyaslabs</groupId>
            <artifactId>module-switch-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Every module's implementation. -->
        <dependency>
            <groupId>com.example.shop</groupId>
            <artifactId>users-impl</artifactId>
        </dependency>
        <dependency>
            <groupId>com.example.shop</groupId>
            <artifactId>catalog-impl</artifactId>
        </dependency>
        <dependency>
            <groupId>com.example.shop</groupId>
            <artifactId>inventory-impl</artifactId>
        </dependency>
        <dependency>
            <groupId>com.example.shop</groupId>
            <artifactId>payments-impl</artifactId>
        </dependency>
        <dependency>
            <groupId>com.example.shop</groupId>
            <artifactId>orders-impl</artifactId>
        </dependency>

        <dependency>
            <groupId>io.github.ilyaslabs</groupId>
            <artifactId>module-switch-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>shop</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
